# DBTITLE 1,Import CSV codelists
codelist_prostate_cancer = spark.createDataFrame(
    pd.read_csv('./codelists/prostate_cancer_snomed.csv')
    .assign(name='prostate_cancer', terminology='SNOMED')
    [['name', 'terminology', 'code', 'term']]
)

codelist_pregnancy = spark.createDataFrame(
    pd.read_csv('./codelists/pregnancy_snomed.csv')
    .assign(name='pregnancy', terminology='SNOMED')
    [['name', 'terminology', 'code', 'term']]
)

# COMMAND ----------

# DBTITLE 1,Derive COCP and HRT BNF codes
def get_bnf_meds_by_code_segment(substring, name):
    """ Given the start of a BNF code, and the covariate name it should correspond to in the codelist,
    Obtains all BNF codes starting with the given substring and produces a codelist table in the appropriate structure
    """
    bnf_subset = bnf_code_info.where(
        f.substring(f.col('BNF_Presentation_Code'), 1, len(substring)) == substring
    )

    result = (
        bnf_subset
        .drop_duplicates(['BNF_Presentation_Code'])
        .select('BNF_Presentation_Code','BNF_Presentation')
        .withColumn('name', f.lit(name))
        .withColumn('terminology', f.lit('BNF'))
        .withColumnRenamed('BNF_Presentation_Code', 'code')
        .withColumnRenamed('BNF_Presentation', 'term')
    )

    return result

dss_cocp, dss_hrt = (
    get_bnf_meds_by_code_segment('070301', 'cocp'),
    get_bnf_meds_by_code_segment('0604011', 'hrt'),
)

# COMMAND ----------

# DBTITLE 1,Combine
# Union all the imported and derived QA codelists together
codelist_quality_assurance = reduce(DataFrame.unionByName, [codelist_prostate_cancer, codelist_pregnancy, dss_cocp, dss_hrt])

codelists_all['qa'] = codelist_quality_assurance

# COMMAND ----------

# MAGIC %md # 4. Check

# COMMAND ----------

count_nulls = lambda df: sum(df.select("*").where(f.col(_).isNull()).count() for _ in df.columns)
required_columns = ['name', 'terminology', 'code', 'term']

for key, codelist in codelists_all.items():
    assert set(codelist.columns) == set(required_columns), f"Codelist {key} is either missing required columns or has extraneous ones"
    assert codelist.count() > 0, f"Codelist {key} is empty" 
    assert count_nulls(codelist) == 0, f'Codelist {key} contains NULLs'
  

# COMMAND ----------

# MAGIC %md # 5. Reformat

# COMMAND ----------

# DBTITLE 1,Clean ICD-10 codes
def clean_icd_codelist(df): 
    """ Given a dataframe containing a codelist including ICD-10 codes,
    Removes trailing X's, decimal points, dashes, and spaces in the ICD-10 codes 
    """
    return (
        df
        .withColumn('code', f.when(f.col('terminology') == 'ICD10', f.regexp_replace('code', r'X$', '')).otherwise(f.col('code')))
        .withColumn('code', f.when(f.col('terminology') == 'ICD10', f.regexp_replace('code', r'[\.\-\s]', '')).otherwise(f.col('code')))
    )

for key, codelist in codelists_all.items():
    codelists_all[key] = clean_icd_codelist(codelist)

