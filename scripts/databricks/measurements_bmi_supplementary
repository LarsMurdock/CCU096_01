# COMMAND ----------

# no data cleaning has been applied to the derived BMI
# records that are outwith realistic lower and upper limits may be removed (e.g. BMI readings <10 and >270)

bmi_final_total = bmi_final.count()
bmi_lower = bmi_final.filter(f.col("BMI") < 10).count()
bmi_upper = bmi_final.filter(f.col("BMI") > 270).count()
bmi_outliers = bmi_lower + bmi_upper
bmi_outliers_percentage = round((bmi_outliers/bmi_final_total)*100,3)

print(f'Total number of records: {bmi_final_total}')
print(f'Number of records with BMI < 10: {bmi_lower}')
print(f'Number of records with BMI > 270: {bmi_upper}')   
print(f'Number of records with BMI outside limits (%): {bmi_outliers_percentage}')                

