import pyspark.sql.functions as f
import pandas as pd
import os
from pyspark.sql.window import Window

# COMMAND ----------

# MAGIC %run /Workspace/Shared/SHDS/common/functions

# COMMAND ----------

# DBTITLE 1,USER INPUT
# Select your GDPP archive version
archive_version = f'2025-07-28'
# Select your demographics version 
demographics_version = f'2025_07_28'

# save table date
save_date = f'2025_07_28'

# minimum ages stratified by gender (height records are not considered before these ages)
male_min_age = 18
female_min_age = 18
unknown_min_age = 18 # if sex is recorded as I or null

# Height min and max in cms
height_max = 272
height_min = 50

# % of records that agree in order to take forward mode over mean as resolved height (set to 0 for mean only appraoch)
height_modal_percentage = 0.8

# Weight min and max in kg
weight_max = 635
weight_min = 25

# COMMAND ----------

db = ''
dbc = f'{db}_collab'
gdppr = spark.table(f'{dbc}.gdppr_{db}_archive').filter(f.col("archived_on")==archive_version)

dsa = f''
demographics = (
    spark.table(f'{dsa}.hds_curated_assets__demographics_{demographics_version}')
    # person must have a valid date of birth
    .filter(f.col("date_of_birth").isNotNull())
)

# ensure gdppr only contains persons in the demographics table (with valid date of birth)
gdppr = gdppr.join(
    demographics.select("person_id"),
    gdppr["NHS_NUMBER_DEID"] == demographics["person_id"],
    how="inner"
).drop(demographics["person_id"])

# COMMAND ----------

# convert ages to days
male_days = male_min_age * 365
female_days = female_min_age * 365
unknown_days = unknown_min_age * 365

# COMMAND ----------

# dates may also be filtered to account for individual censor end dates or gdppr lag (last observable dates)
gdppr_prepared = (

  gdppr

  .select(f.col('NHS_NUMBER_DEID').alias("PERSON_ID"), 'DATE', 'CODE', f.col('VALUE1_CONDITION').alias("VALUE"))
  .filter(f.col('PERSON_ID').isNotNull())  
  .filter(f.col('VALUE').isNotNull())
  .withColumn("DATE", f.when((f.col("DATE") == "1800-01-01") | (f.col("DATE") == "1801-01-01"), None).otherwise(f.col("DATE")))
  .filter(f.col('DATE').isNotNull())

  # remove records that occur before the min gender specific ages
  .join(demographics.select("person_id", "date_of_birth", "sex", "date_of_death"), on="PERSON_ID", how="inner")
  .filter(
    f.when(
      f.col("sex") == "M", f.datediff(f.col("DATE"), f.col("date_of_birth")) >= male_days)
    .when(
      f.col("sex") == "F", f.datediff(f.col("DATE"), f.col("date_of_birth")) >= female_days)
    .otherwise(
      f.datediff(f.col("DATE"), f.col("date_of_birth")) >= unknown_days)
    )

    # remove records before date of birth or after date of death
    .filter(f.col("DATE") >= f.col("date_of_birth"))
    .filter((f.col("date_of_death").isNull()) | (f.col("DATE") <= f.col("date_of_death")))

    .drop("date_of_birth","sex", "date_of_death")

)

# COMMAND ----------

# codelists
codelists_path = f'/Workspace{(os.path.dirname(dbutils.notebook.entry_point.getDbutils().notebook().getContext().notebookPath().get()))}/codelists/'

codelist_path_height = f'{codelists_path}height_snomed.csv'
codelist_height_df = (
    spark.createDataFrame(pd.read_csv(codelist_path_height, keep_default_na=False))
    .select(f.regexp_replace("code", "^'", "").alias("CODE"))
)

codelist_path_weight = f'{codelists_path}weight_snomed.csv'
codelist_weight_df = (
    spark.createDataFrame(pd.read_csv(codelist_path_weight, keep_default_na=False))
    .select(f.regexp_replace("code", "^'", "").alias("CODE"))
)

# COMMAND ----------

height_unique_codes_list = [row['CODE'] for row in codelist_height_df.select("CODE").distinct().collect()]
gdppr_height = (
    gdppr_prepared
    .filter(f.col("CODE").isin(height_unique_codes_list))
    .select("PERSON_ID","DATE",f.col("VALUE").alias("HEIGHT"))
    .distinct()
)

weight_unique_codes_list = [row['CODE'] for row in codelist_weight_df.select("CODE").distinct().collect()]
gdppr_weight = (
    gdppr_prepared
    .filter(f.col("CODE").isin(weight_unique_codes_list))
    .select("PERSON_ID","DATE",f.col("VALUE").alias("WEIGHT"))
    .distinct()
)

# COMMAND ----------

# Earliest and latest dates for height and weight
min_date_height, max_date_height = gdppr_height.select(f.min("DATE"), f.max("DATE")).first()
min_date_weight, max_date_weight = gdppr_weight.select(f.min("DATE"), f.max("DATE")).first()
min_date = min(min_date_height, min_date_weight)
max_date = max(max_date_height, max_date_weight)

# COMMAND ----------

# remove heights <=0
gdppr_height_clean = gdppr_height.filter(f.col("HEIGHT") > 0)

# COMMAND ----------

# convert heights in metres to cm
gdppr_height_clean = (
    gdppr_height_clean
    .withColumn("HEIGHT",
                f.when(f.col("HEIGHT") < (height_min / 100), f.col("HEIGHT") * 100).otherwise(f.col("HEIGHT"))
                )
)

# COMMAND ----------

# remove heights above height max and below height min
gdppr_height_clean = (
    gdppr_height_clean
    .filter(f.col("HEIGHT") <= height_max)
    .filter(f.col("HEIGHT") >= height_min)
    # get distinct measurements
    .distinct()
)

# COMMAND ----------

# Count how many times each height occurs per person
gdppr_height_clean_count = (
    gdppr_height_clean.select("PERSON_ID", "DATE", "HEIGHT").distinct()
      .withColumn("total", f.count("*").over(Window.partitionBy("PERSON_ID")))
      .withColumn("height_count", f.count("*").over(Window.partitionBy("PERSON_ID", "HEIGHT")))
      .withColumn("height_ratio", f.col("height_count") / f.col("total"))
)

# Filter those where one height occurs >= height_modal_percentage (e.g. 80%) of the time
height_mode = (
    gdppr_height_clean_count
    .filter(f.col("height_ratio") >= height_modal_percentage)
    .orderBy("PERSON_ID", f.desc("height_count"))
    .withColumn("row_number", f.row_number().over(Window.partitionBy("PERSON_ID").orderBy(f.desc("height_count"))))
    .filter(f.col("row_number") == 1)
    .select("PERSON_ID", "HEIGHT")
    .withColumnRenamed("HEIGHT", "resolved_height")
)

# For others fallback to average
height_avg = (
    gdppr_height_clean_count.groupBy("PERSON_ID")
    .agg(f.avg("HEIGHT").alias("resolved_height"))
)

# Combine (prioritising mode)
height_final = (
    height_mode.unionByName(height_avg, allowMissingColumns=True).dropDuplicates(["PERSON_ID"])
    .withColumn("resolved_height_m", f.col("resolved_height")/100)
)

# COMMAND ----------

# remove weights <=0
gdppr_weight_clean = gdppr_weight.filter(f.col("WEIGHT") > 0)

# COMMAND ----------

# remove weights above weight max and below weight min
gdppr_weight_clean = (
    gdppr_weight_clean
    .filter(f.col("WEIGHT") <= weight_max)
    .filter(f.col("WEIGHT") >= weight_min)
    # get distinct measurements
    .distinct()
    # impute mean for ties on same date
    .withColumn("weight_count", f.count("WEIGHT").over(Window.partitionBy("PERSON_ID", "DATE")))
      .withColumn("weight_mean", f.mean("WEIGHT").over(Window.partitionBy("PERSON_ID", "DATE")))
      .withColumn(
          "WEIGHT",
          f.when(f.col("weight_count") > 1, f.col("weight_mean")).otherwise(f.col("WEIGHT"))
      )
      .drop("weight_count", "weight_mean")
)

# COMMAND ----------

bmi_final = (
    gdppr_weight_clean
    .join(height_final, on="PERSON_ID", how="inner")
    .withColumn("BMI", f.col("WEIGHT")/f.pow(f.col("resolved_height_m"),2))
)

# COMMAND ----------

# censor starts (the first weight record per person)
censor_starts = bmi_final.groupBy("PERSON_ID").agg(f.min("DATE").alias("censor_start")).distinct()

# censor ends (date of death, else the global max date)
censor_ends = (
    bmi_final.join((demographics.select("PERSON_ID", "date_of_death")).withColumnRenamed("date_of_death", "censor_end"), on="PERSON_ID", how="left")
    .select("PERSON_ID","censor_end")
    .withColumn("censor_end", f.when(f.col("censor_end").isNotNull(), f.col("censor_end")).otherwise(max_date))
    .distinct()
    )

bmi_final = (
    bmi_final.join(censor_starts, on="PERSON_ID", how="inner").join(censor_ends, on="PERSON_ID", how="inner")
)

# COMMAND ----------

save_table(bmi_final, f'hds_supplementary__bmi_{save_date}', save_previous=False)

