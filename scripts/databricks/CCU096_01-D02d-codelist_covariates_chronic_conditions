# DBTITLE 1,Clean ICD-10 codes
def clean_icd_codelist(df): 
    """ Given a dataframe containing a codelist including ICD-10 codes,
    Removes trailing X's, decimal points, dashes, and spaces in the ICD-10 codes 
    """
    return (
        df
        .withColumn('code', f.when(f.col('terminology') == 'ICD10', f.regexp_replace('code', r'X$', '')).otherwise(f.col('code')))
        .withColumn('code', f.when(f.col('terminology') == 'ICD10', f.regexp_replace('code', r'[\.\-\s]', '')).otherwise(f.col('code')))
    )

codelist = clean_icd_codelist(codelist)

