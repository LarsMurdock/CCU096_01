# MAGIC %md ### 4.1 Diabetes
# MAGIC
# MAGIC The pre-made codelist has done all the heavy lifting - we merely import the relevant CSV and use the `DiabetesType` field to form all the different diabetes covariates: general diabetes, MODY, type 1, type 2, and "other". 

# COMMAND ----------

# DBTITLE 1,Import diabetes CSV
import_diabetes = spark.createDataFrame(
    pd.read_csv('./codelists/diabetes_complete.csv')
    [['name', 'terminology', 'code', 'term', 'DiabetesType']]
)

codelist_diabetes = (
    import_diabetes
    # Filter out some exclusions
    .where(f.col("code") != "1109921000000106")
    .where(f.col("DiabetesType") != "removed")
    # Introduce diabetes type-specific covariate names based on the DiabetesType field in the CSV 
    # Names will be: diabetes_general, diabetes_other, diabetes_type1, diabetes_type2, and diabetes_mody
    .withColumn('name', f.concat(f.lit('diabetes_'), f.lower(f.col('DiabetesType'))))
    .select('name', 'terminology', 'code', 'term')
)

codelists_all['diabetes'] = codelist_diabetes

