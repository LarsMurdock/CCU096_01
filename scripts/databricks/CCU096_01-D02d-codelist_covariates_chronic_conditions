# MAGIC %md ### 4.5 Obesity
# MAGIC
# MAGIC We obtain SNOMED codes for obesity from the phenotype library and, additionally, select the ICD-10 codes for obesity from the reference table (E66 - "Obesity" and its children). We exclude:
# MAGIC  - 248325000 "Undernourished (finding)"
# MAGIC  - 428754001 "Dietary education for food intolerance (procedure)"

# COMMAND ----------

# DBTITLE 1,Derive obesity codelist
obesity_snomed = (
    phenotypes_obesity_snomed
    # Filter some exclusions
    .where(~f.col("ConceptId").isin("248325000","428754001"))
    # Re-format to fit the usual codelist format
    .withColumn("name",f.lit("obesity"))
    .withColumn("terminology",f.lit("SNOMED"))
    .withColumnRenamed('conceptId', 'code')
    .select('name', 'terminology', 'code', 'term')
)

obesity_icd = (
    icd10
    # Select all children of 3-code E66 - Obesity
    .where(f.col("CODE").startswith("E66"))
    # Re-format to fit the usual codelist format
    .withColumn("name",f.lit("obesity"))
    .withColumn("terminology",f.lit("ICD10"))
    .drop('CODE')
    .withColumnRenamed('ALT_CODE', 'code')
    .withColumnRenamed('ICD10_DESCRIPTION', 'term')
    .select('name', 'terminology', 'code', 'term')
)


codelist_obesity = obesity_snomed.unionByName(obesity_icd) 

codelists_all['obesity'] = codelist_obesity

