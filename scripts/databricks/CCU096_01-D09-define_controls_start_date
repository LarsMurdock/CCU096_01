# DBTITLE 1,Import data sources
# Sources for basic inclusion/exclusion
skinny           = spark.table(Paths.cur_skinny)
inc_exc_controls = spark.table(f'{Project.dsa}.{Project.name}_tmp_inc_exc_cohort_controls')
first_record     = spark.table(f'{Project.dsa}.{Project.name}_tmp_earliest_medical_dates')

# COMMAND ----------

# MAGIC %md # 3. Prepare

# COMMAND ----------

# Earliest medical record dates
first_record_1 = first_record.select('PERSON_ID', f.col('DATE').alias('GDPPR_EARLIEST'))

df_starting = (
    skinny
    .join(inc_exc_controls.select('PERSON_ID'), on='PERSON_ID', how='inner')
    .join(first_record_1, on='PERSON_ID', how='left')
    .withColumn("date_18", f.add_months(f.col('date_of_birth'), 18*12))
    .withColumn('entry_date', f.greatest(f.col('date_18'), f.col('GDPPR_EARLIEST'), f.to_date(f.lit(Project.study_start_date))))
    .select('PERSON_ID', 'entry_date')
)

# COMMAND ----------

# MAGIC %md # 7. Save

# COMMAND ----------

# DBTITLE 1,Save post-inclusion/exclusion cohort
save_table(df=df_starting, out_name=f'{Project.name}_tmp_inc_exc_controls_start_date', save_previous=True)