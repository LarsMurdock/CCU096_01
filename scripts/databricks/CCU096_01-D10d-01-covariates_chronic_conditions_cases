    .withColumnRenamed('date_of_birth', 'CENSOR_DATE_START')
    .withColumnRenamed('cov_hx_first_obesity_30kgm2_date', 'CENSOR_DATE_END')
    # Filter to time window - record must be after the patient's DOB but before the baseline date
    .where((f.col('DATE') > f.col('CENSOR_DATE_START')) & (f.col('DATE') <= f.col('CENSOR_DATE_END')))
)

