# DBTITLE 1,Obtain a table of age at earliest diabetes diagnosis
diabetes_phenotypes = ['diabetes_type1', 'diabetes_type2', 'diabetes_mody', 'diabetes_general', 'diabetes_other']
generic_phenotypes = diabetes_phenotypes[-2:]

# Take two subsets of the full matching table: One with generic diabetes codes, and one with all the rest
matches_diabetes, matches_other = (
    hx_out_all.where(f.col('name').isin(generic_phenotypes)),
    hx_out_all.where(~f.col('name').isin(generic_phenotypes))
)

matches_diabetes = (
    matches_diabetes 
    # Left join with the skinny table to obtain DOB at the record date for each matched record
    .join(skinny.select('PERSON_ID', 'date_of_birth'), on='PERSON_ID', how='left')

    # Obtain the age at the record date 
    .withColumn('_diabetes_age', f.datediff('DATE', 'date_of_birth')/365.25)

    # Overwrite the generic diabetes phenotypes according to the age at the record date
    .withColumn('name', f 
        .when(f.col('_diabetes_age') >= 30, 'diabetes_type2')
        .when(f.col('_diabetes_age') < 30, 'diabetes_type1')
    )
)

print(f"Have {matches_diabetes.count()} generic diabetes codes out of {hx_out_all.where(f.col('name').isin(diabetes_phenotypes)).count()} total diabetes codes")
print(f"Re-typing {matches_diabetes.where(f.col('_diabetes_age') >= 30).count()}/{matches_diabetes.count()} generic diabetes codes as type 2")
print(f"Re-typing {matches_diabetes.where(f.col('_diabetes_age') < 30).count()}/{matches_diabetes.count()} generic diabetes codes as type 1")

# Drop extraneous columns and re-combine the two subsets of the full matching table
hx_out_all = matches_other.unionByName(
    matches_diabetes.drop('date_of_birth', '_diabetes_age')
)

