    df
    # Filter nulls
    .where(f.col('PERSON_ID').isNotNull() & f.col('DATE').isNotNull())
    # Join with cohort to limit size a bit
    .join(cohort.select('PERSON_ID', 'date_of_birth', 'cov_hx_first_obesity_30kgm2_date'), on='PERSON_ID', how='inner')
