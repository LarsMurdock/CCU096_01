# DBTITLE 1,Overall Coverage
def table_coverage(df): 
    # Magic query to obtain the coverage count of each given column
    result = df.select([(f.count(f.when(f.col(c).isNotNull(), c))).alias(c) for c in df.columns])
    # Transpose table to obtain counts as a column
    result = result.toPandas().T.reset_index().rename(columns={'index': 'Column', 0: 'Count'})
    # Take the fraction of the total records for each count
    result['Coverage'] = (result['Count'] / df.count()).round(4)
    # Sort by coverage descending 
    return result.sort_values('Coverage', ascending=True)

