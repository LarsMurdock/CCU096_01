# DBTITLE 1,Define inclusion rules (ethnicity-specific obesity)
conditions, condition_descriptions = {}, {}
baseline_date = f.to_date(f.lit(Project.study_start_date))
study_end_date = f.to_date(f.lit(Project.study_end_date))

# Condition 1: Exclude patients who failed the quality assurance
# This step implicitly removes ~19m individuals from the skinny table with missing DOB or sex.
conditions[1] = (f.col('_rule_total').isNull())
condition_descriptions[1] = "Post exclusion of patients who failed the quality assurance"

# Condition 2: Exclude patients who died before baseline 
conditions[2] = (f.col('date_of_death').isNull() | (f.col('date_of_death') > baseline_date))
condition_descriptions[2] = "Post exlusion of patients who died before baseline"

# Condition 3: Exclude patients not in GDPPR
conditions[3] = (f.col('in_gdppr') == 1)
condition_descriptions[3] = "Post exclusion of patients not in GDPPR"

# Condition 4: Exclude patients with a region outside of England (including nulls)
conditions[4] = f.col('region').isNotNull() & ~f.col('region').isin(['Scotland', 'Wales'])
condition_descriptions[4] = "Post exclusion of patients outside England (also excluding missing region)"

# Condition 5: Exclude patients aged < 18 at end of follow-up
index_minus_18y = f.add_months(study_end_date, -18*12)
conditions[5] = (f.col('date_of_birth') <= index_minus_18y)
condition_descriptions[5] = "Post exclusion of patients aged < 18 years at study end date"

# Condition 6: Exclude patients aged > 99 at baseline
index_minus_100y = f.add_months(baseline_date, -100*12)
conditions[6] = (f.col('date_of_birth') >= index_minus_100y)
condition_descriptions[6] = "Post exclusion of patients aged >= 100 years at baseline"

#***REMOVED***Condition 7: Exclude patients without any diagnosis of obesity
conditions[7] = f.col('cov_hx_first_obesity_date').isNotNull()
condition_descriptions[7] = 'Post exclusion of patients without any diagnosis of obesity'

# Condition 8: Exclude patients whose first record of obesity is before their first visit in GDPPR
conditions[8] = (f.col('cov_hx_first_obesity_date') >= f.col('GDPPR_FIRST'))
condition_descriptions[8] = "Post exclusion of patients whose first record of obesity is before their first visit in GDPPR"

# Condition 9: Exclude patients whose first record of obesity is before their date of birth
conditions[9] = (f.col('cov_hx_first_obesity_date') >= f.col('date_of_birth'))
condition_descriptions[9] = "Post exclusion of patients whose first record of obesity is before their date of birth"

# Condition 10: Exclude patients whose first record of obesity is after their date of death
conditions[10] = ((f.col('cov_hx_first_obesity_date') <= f.col('date_of_death')) | (f.col('date_of_death').isNull()))
condition_descriptions[10] = "Post exclusion of patients whose first record of obesity is after their date of death"

# Condition 11: Exclude patients whose first record of obesity is after the project end date
conditions[11] = (f.col('cov_hx_first_obesity_date') <= Project.study_end_date)
condition_descriptions[11] = "Post exclusion of patients whose first record of obesity is after the project end date"

