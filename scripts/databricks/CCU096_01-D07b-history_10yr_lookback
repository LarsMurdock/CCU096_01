# DBTITLE 1,Main analysis
# List of all date columns starting with 'cov_hx_' and ending with '_date'
date_columns = [_ for _ in history_wide1.columns if _.startswith('cov_hx_') and _.endswith('_date')]

# Exclude 'cov_hx_bmi275_date' for individuals of certain ethnicities (see below)
date_columns_excluding_bmi275 = [col for col in date_columns if col != 'cov_hx_bmi275_date']

history_wide2 = (
    history_wide1
    .join(skinny.select(f.col('person_id').alias('PERSON_ID'), 'ethnicity_5_group', 'ethnicity_18_group'), on='PERSON_ID', how='left')
    # Conditional logic for defining 'cov_hx_first_obesity_date'
    .withColumn(
        'cov_hx_first_obesity_date',
        f.when(
            f.col('ethnicity_5_group').rlike('Asian|Black'),
            f.least(*[f.col(col) for col in date_columns])  # Use all date columns for Asian and Black individuals
        ).when(
            f.col('ethnicity_18_group').rlike('Arab'),
            f.least(*[f.col(col) for col in date_columns]) # Include Middle Eastern individuals (Arabs)
        ).otherwise(
            f.least(*[f.col(col) for col in date_columns_excluding_bmi275])  # Exclude 'cov_hx_bmi275_date' for others
        )
    )
    # Conditional logic for defining 'cov_hx_first_obesity_30kgm2_date'
    .withColumn(
        'cov_hx_first_obesity_30kgm2_date',
         f.least(*[f.col(col) for col in date_columns_excluding_bmi275])
    )
    .drop('ethnicity_5_group', 'ethnicity_18_group')
)

