window_duplicates_bmi275 = define_window('PERSON_ID', 'cov_hx_bmi275_date')

import operator
from pyspark.sql import functions as f

def process_bmi_threshold(
    df, 
    threshold, 
    age_threshold, 
    age_comparator,   # e.g., operator.ge or operator.le
    date_col_alias, 
    flag_col_name, 
    window_spec,
    sex_filter=None   # Optional: "M", "F", or None
):
    condition = (
        (f.col('VALUE1_CONDITION') >= threshold) &
        age_comparator(f.col('_age_at_record_date'), age_threshold)
    )
    
    if sex_filter is not None:
        condition = condition & (f.col('sex') == sex_filter)

    return (
        df
        .where(condition)
        .select(
            "PERSON_ID",
            "_age_at_record_date",
            "sex",
            f.col('DATE').alias(date_col_alias)
        )
        .withColumn(flag_col_name, f.lit(1))
        .withColumn('_rank', f.row_number().over(window_spec))
        .where(f.col('_rank') == 1)
        .drop('_rank')
    )

