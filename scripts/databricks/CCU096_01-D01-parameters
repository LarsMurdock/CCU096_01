# DBTITLE 1,Define load_dataset_batch
# This function loads a specified dataset and compares the expected number of rows (the number that were found when running the parameters notebook in full) against the number of rows observed (the number that are found when extracting the data from the archive in a subsequent notebook). This alerst us to the number of rows being changed in the archive tables, which the data wranglers control.

# Successor to extract_batch_from_archive

from pyspark.sql import DataFrame
def load_dataset_batch(dataset: str, parameters_df_datasets: pd.DataFrame = Project.parameters_df_datasets) -> DataFrame:
    # Get the element from Project.parameters_df_datasets corresponding to the specified dataset 
    if dataset not in parameters_df_datasets.index:
        raise ValueError(f'Dataset "{dataset}" not found in parameters_df_datasets. Available options: {parameters_df_datasets.index.values}')
    batch = parameters_df_datasets.loc[dataset]

    # Create path and extract archived on
    batch_path = f'{batch.database}.{batch.table}'

    # Extract batch 
    df = spark.table(batch_path).where(f.col('archived_on') == batch.archived_on)

    # Check observed number of rows against expected number
    n_rows_observed = df.count()
    assert n_rows_observed > 0, 'Empty dataset - n_rows_observed = 0'
    assert n_rows_observed == batch.n_rows, f'Non-matching dataset size: Expected {batch.n_rows} rows, got {n_rows_observed}.'

    return df 

