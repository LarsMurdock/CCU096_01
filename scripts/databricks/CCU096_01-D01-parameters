# DBTITLE 1,Derive parameters_df_datasets
from pyspark.sql.column import Column 
from typing import Iterable 
def _aggregate_archived_on(dataset: str, database: str, table: str, filters: Iterable[Column]) -> pd.DataFrame:
    """ Given a dataset name and relevant location (database and table) and any boolean filters to apply,
    Extracts the latest (most recent) archived_on date that matches the given filters, plus the count of rows for that batch. """
    # extract latest (most recent) archived_on date before the pipeline_production_date
    # Load up the dataset table from the given location
    df_dataset = spark.table(f'{database}.{table}')

    # Group by archival date, aggregate row counts per distinct archival date, filter by provided filters
    df_grouped = (
        df_dataset 
        .groupBy('archived_on')
        .agg(f.count(f.lit(1)).alias('n_rows'))
        .where(filters)
    )

    result = (
        df_grouped 
        # Pick the latest date (that wasn't filtered out) and its metadata
        .orderBy(f.desc('archived_on'))
        .limit(1)
        .withColumn('dataset', f.lit(dataset))
        .select('dataset', 'archived_on', 'n_rows')
    )

    return result.toPandas()

def _extract_latest_archived_on(dataset, database, table, pipeline_production_date = Project.pipeline_production_date):
    """ Given a dataset name and location, extracts the latest archival date BEFORE the pipeline_production_date and its row count. """
    return _aggregate_archived_on(dataset, database, table, filters=(f.col('archived_on') <= pipeline_production_date))

def _extract_earliest_archived_on(dataset, database, table, study_start_date = Project.study_start_date):
    """ Given a dataset name and location, extracts the closest archival date that comes AFTER the study_start_date and it's row count. """
    return _aggregate_archived_on(dataset, database, table, filters=(f.col('archived_on') >= study_start_date))

# We will now derive the parameters_df_datasets dataframe, containing the latest archival dates and row counts per dataset
# this will not run each time the Parameters notebook is run in annother notebook - it will only run if the toggle is switched to True
