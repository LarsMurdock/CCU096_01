# DBTITLE 1,Utility function overrides
# The pipeline makes a lot of calls to utility functions such as tab, tabastat, count_var, etc. 
# These are nice for development but take very long to run, wasting time when we want the pipeline to execute end-to-end (e.g. a single count_var can take 4 hours!! on GDPPR)
# So we override them to not do anything if debug_mode is set to False 

from pyspark.sql import DataFrame
from typing import Any, Callable, List, Mapping, Optional, Tuple

_merge, _tab, _tabstat, _count_var, _count_varlist = merge, tab, tabstat, count_var, count_varlist

def merge(df1: DataFrame, df2: DataFrame, ilist, quietly=0, broadcast_right=0, validate=None, assert_results=None, keep_results=None, indicator=1) -> DataFrame:
    quietly = int(not Project.debug)
    return _merge(df1, df2, ilist, quietly, broadcast_right, validate, assert_results, keep_results, indicator)

def tab(df, var1, var2=None, var2_wide=1, var2_unstyled=1, cumsum=0):
    if Project.debug:
        return _tab(df, var1, var2, var2_wide, var2_unstyled, cumsum)

def tabstat(df, var, byvar=None, date=0):
    if Project.debug:
        return _tabstat(df, var, byvar, date)

def count_var(df, var1: str, ret=0, df_desc='', indx=0) -> None:
    if Project.debug:
        return _count_var(df, var1, ret, df_desc, indx)

def count_varlist(df, varlist):
    if Project.debug:
        return _count_varlist(df, varlist)

