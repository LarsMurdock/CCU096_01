    .join(inc_exc.select('PERSON_ID', 'entry_date'), on='PERSON_ID', how='inner')

    # Filter per the dates we set above
    .where(
        (f.col('DATE') > smoking_start_date) & 
        (f.col('DATE') <= smoking_end_date)
