# MAGIC %md # 7. Deaths
# MAGIC
# MAGIC We curate the deaths table into a wide format and a long format:
# MAGIC - The wide table has format `(PERSON_ID, REG_DATE, REG_DATE_OF_DEATH, S_COD_CODE_UNDERLYING, S_COD_CODE_1, S_COD_CODE_2, ...)`
# MAGIC - The long table has format `(PERSON_ID, DATE, DIAG_POSITION=(UNDERLYING|1,...,15), DIAG_DIGITS=(3|4), CODE)`

# COMMAND ----------

# DBTITLE 1,Wide format
# Define window for the purpose of reducing the deaths table to one row per individual 
# We will pick the first death record per person ordered by most recent registration date/DOD
_win = (
    Window
    .partitionBy('PERSON_ID')
    .orderBy(f.desc('REG_DATE'), f.desc('REG_DATE_OF_DEATH'), f.desc('S_COD_CODE_UNDERLYING'))
)

# Regex match the names of the diagnostic code columns 
deaths_diag_columns = [col for col in deaths.columns if col.startswith('S_COD_CODE_')]

deaths_out_wide = (
    deaths
    # Rename ID column
    .withColumnRenamed('DEC_CONF_NHS_NUMBER_CLEAN_DEID', 'PERSON_ID')
    .withColumnRenamed('S_UNDERLYING_COD_ICD10', 'S_COD_CODE_UNDERLYING')

    # Convert REG_DATE and  REG_DATE_OF_DEATH to datetimes
    .withColumn('REG_DATE', f.to_date(f.col('REG_DATE'), 'yyyyMMdd'))
    .withColumn('REG_DATE_OF_DEATH', f.to_date(f.col('REG_DATE_OF_DEATH'), 'yyyyMMdd'))

    # Filter null IDs
    .where(f.col('PERSON_ID').isNotNull())

    # Select only one row per ID, the first one ordered by REG_DATE, REG_DATE_OF_DEATH, and presence of cause-of-death codes
    .withColumn('_rank', f.row_number().over(_win))
    .where(f.col('_rank') == 1)

    # Select, including all diagnostic code columns
    .select(['PERSON_ID', 'REG_DATE', 'REG_DATE_OF_DEATH', 'S_COD_CODE_UNDERLYING'] + deaths_diag_columns)
)

# COMMAND ----------

# DBTITLE 1,Long format
# Remove records with missing DOD
deaths_out_long = (
    deaths_out_wide
    .where(f.col('REG_DATE_OF_DEATH').isNotNull())
    .drop('REG_DATE')
    .withColumnRenamed('REG_DATE_OF_DEATH', 'DATE')
)

# First reshape
# We increment the diagnosis position to start at 1 (c.f., 0) - will avoid confusion with HES-APC long, which start at 1
deaths_out_long = (
    # Go from (PERSON_ID, DATE, DIAG_UNDERLYING, DIAG_SEC_1, ...) to (PERSON_ID, DATE, DIAG_POSITION=UNDERLYING, CODE=_)
    reshape_wide_to_long(deaths_out_long, i=['PERSON_ID', 'DATE'], j='DIAG_POSITION', stubname='S_COD_CODE_')

    # Add "SECONDARY_" prefix to non-UNDERLYING causes of death entries
    .withColumn('DIAG_POSITION', f.when(
      f.col('DIAG_POSITION') != 'UNDERLYING', f.concat(f.lit('SECONDARY_'), f.col('DIAG_POSITION'))).otherwise(f.col('DIAG_POSITION'))
    )
    
    # Rename the code column to indicate 4-codes
    .withColumnRenamed('S_COD_CODE_', 'CODE4')\
    
    # Derive the 3-codes from the 4-codes
    .withColumn('CODE3', f.substring(f.col('CODE4'), 1, 3))
)

# Remove records with missing cause of death
deaths_out_long = deaths_out_long.where(f.col('CODE4').isNotNull())

deaths_out_long = (
    # Go from (PERSON_ID, DATE, DIAG_POSITION, 3CODE, 4CODE) to (PERSON_ID, DATE, DIAG_POSITION, DIAG_DIGITS=3, CODE), (PERSON_ID, DATE, DIAG_POSITION, DIAG_DIGITS=4, CODE)
    reshape_wide_to_long(deaths_out_long, i=['PERSON_ID', 'DATE', 'DIAG_POSITION'], j='DIAG_DIGITS', stubname='CODE')

    # Remove whitespaces, hyphens, commas
    .withColumn('CODE', f.regexp_replace('CODE', r'[.,\-\s]', ''))
)

# COMMAND ----------

