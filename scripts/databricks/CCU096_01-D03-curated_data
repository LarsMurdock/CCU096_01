# MAGIC %md # 3. HES_APC
# MAGIC
# MAGIC We curate HES-APC by extracting all the diagnostic codes per event per patient. We store these in long format: `(PERSON_ID, DIAG_POSITION, DIAG_DIGIT, DIAG_VALUE)` where `DIAG_POSITION` indicates if each code was the 1st, 2nd, etc code in that episode; `DIAG_DIGIT` indicates whether it's a 3-code or 4-code; and `DIAG_VALUE` gives the ICD-10 code in question.

# COMMAND ----------

# DBTITLE 1,Prepare HES-APC
# Select columns (PERSON_ID, RECORD_ID, DATE, Diagnostic columns)
# Note: I have deleted code attempting to coalesce the `EPISTART` and `ADMIDATE` in case the former is missing. Because it turns out that `ADMIDATE` is always null when `EPISTART` is null.
hes_diag_columns = [col for col in hes_apc.columns if col.startswith('DIAG_')]
hes_apc_prepared = (
    hes_apc  
    .select(['PERSON_ID_DEID', 'EPIKEY', 'EPISTART'] + hes_diag_columns)
    .drop('DIAG_3_CONCAT', 'DIAG_4_CONCAT', 'DIAG_COUNT')
    .withColumnRenamed('PERSON_ID_DEID', 'PERSON_ID')
)

# COMMAND ----------

# MAGIC %md We reshape the initial (wide-format) HES-APC table twice. 
# MAGIC 1. First, we melt along the diagnosis index. We go from `(PERSON_ID, DIAG_1, DIAG_2, ...)` format to `(PERSON_ID, POSITION = 1, DIAG_3_CODE, DIAG_4_CODE), (PERSON_ID, POSITION = 2, DIAG_3_CODE, DIAG_4_CODE)`
# MAGIC 2. Then, we melt along the code length. We go from `(PERSON_ID, POSITION=_, DIAG_3_CODE, DIAG_4_CODE)` to `(PERSON_ID, POSITION=01, DIAG_DIGIT=3, DIAG_VALUE), (PERSON_ID, POSITION=01 again, DIAG_DIGIT=4, DIAG_VALUE)`
# MAGIC
# MAGIC We additionally check whether the recorded 3-code and 4-code per record match, by taking the corresponding substring of the 4-code and comparing. Finally, we clean up the ICD-10 codes by removing X-codes, whitespace, commas, and hyphens.

# COMMAND ----------

# DBTITLE 1,First reshape
hes_apc_long = (
  # Go from (PERSON_ID, ..., DIAG_1, DIAG_2, DIAG_3) to (PERSON_ID, ..., POSITION=1, DIAG), (PERSON_ID, ..., POSITION=2, DIAG)
  reshape_wide_to_long_multi(hes_apc_prepared, i=['PERSON_ID', 'EPIKEY', 'EPISTART'], j='POSITION', stubnames=['DIAG_4_', 'DIAG_3_'])

  # Augment with _3code_substring column, manually taking the 3-code out of the ICD-10 4-codes
  .withColumn('_3code_substring', f.substring(f.col('DIAG_4_'), 1, 3))

  # Check whether the recorded 3-code and the one we created match
  .withColumn('_codes_match', udf_null_safe_equality('DIAG_3_', '_3code_substring').cast(t.IntegerType()))

  # Check whether the 4-codes are indeed 4 characters long
  .withColumn('_4code_length', f.length(f.col('DIAG_4_')))
  .withColumn('_4code_length_correct', f.when((f.col('_4code_length').isNull()) | (f.col('_4code_length') <= 4), 1).otherwise(0))
)

# COMMAND ----------

# DBTITLE 1,Check
# Verify no non-matching 3-codes
assert hes_apc_long.where(f.col('_codes_match') == 0).count() == 0

# Verify no 4-codes exceeding 4 characters
assert hes_apc_long.where(f.col('_4code_length_correct') == 0).count() == 0

# Check how many 4-codes less than 4 characters
# Finding: Some
tab(hes_apc_long, '_4code_length'); print()

# COMMAND ----------

# DBTITLE 1,Second reshape
hes_apc_long = (
    # Go from (PERSON_ID, POSITION=_, DIAG_3, DIAG_4) to (PERSON_ID, POSITION=01, DIAG_DIGIT=3, DIAG_VALUE), (PERSON_ID, POSITION=01 again, DIAG_DIGIT=4, DIAG_VALUE)
    reshape_wide_to_long_multi(hes_apc_long, i=['PERSON_ID', 'EPIKEY', 'EPISTART', 'POSITION'], j='DIAG_DIGITS', stubnames=['DIAG_'])
   .withColumnRenamed('POSITION', 'DIAG_POSITION')

   # Remove leading zero from DIAG_POSITION
   .withColumn('DIAG_POSITION', f.regexp_replace('DIAG_POSITION', r'^[0]', ''))

   # Remove terminating underscore from DIAG_DIGITS
   .withColumn('DIAG_DIGITS', f.regexp_replace('DIAG_DIGITS', r'[_]', ''))

   # Remove X-codes 
   .withColumn('DIAG_', f.regexp_replace('DIAG_', r'X$', ''))

   # Remove whitespace, hyphens, commas
   .withColumn('DIAG_', f.regexp_replace('DIAG_', r'[.,\-\s]', ''))
   .withColumnRenamed('DIAG_', 'CODE')

   .where((f.col('CODE').isNotNull()) & (f.col('CODE') != ''))
)

# COMMAND ----------

# DBTITLE 1,Save
