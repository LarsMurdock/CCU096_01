def merge_intervals(intervals):
    ivs = [(i["start"], i["end"]) for i in intervals if i["start"] and i["end"]]
    ivs = sorted(ivs, key=lambda x: x[0])
    merged = []
    for s, e in ivs:
        if not merged or s > merged[-1][1]:
            merged.append([s, e])
        else:
            merged[-1][1] = max(merged[-1][1], e)
    return merged

def min_date(*ds):
    ds = [d for d in ds if d is not None]
    return min(ds) if ds else None

def max_date(*ds):
    ds = [d for d in ds if d is not None]
    return max(ds) if ds else None

@f.udf(segment_schema)
def build_at_risk_segments_udf(person_id,
                               cov_first_obesity,
                               date_of_death,
                               date_100,
                               date_18,
                               gdppr_earliest,
                               pregs):
    from datetime import date
    study_start = date(2019, 11, 1)
    study_end   = date(2025, 4, 30)  # ensure this is a datetime.date object

    start_elig = max_date(study_start, date_18, gdppr_earliest)
    if start_elig is None:
        return []

    # censor can now also happen at study_end
    censor_date = min_date(cov_first_obesity, date_of_death, date_100, study_end)

    if censor_date is not None and censor_date <= start_elig:
        return []

    merged_pregs = merge_intervals(pregs or [])
    segs = []
    current = start_elig

    def censor_reason(end_date):
        choices = []
        if cov_first_obesity and cov_first_obesity == end_date:
            choices.append(("obesity", cov_first_obesity))
        if date_of_death and date_of_death == end_date:
            choices.append(("death", date_of_death))
        if date_100 and date_100 == end_date:
            choices.append(("age100", date_100))
        if study_end and study_end == end_date:
            choices.append(("study_end", study_end))
        order = {"obesity": 0, "death": 1, "age100": 2, "study_end": 3}
        if choices:
            choices.sort(key=lambda t: order[t[0]])
            return choices[0][0]
        return "censor"

    for ps, pe in merged_pregs:
        if censor_date is not None and current >= censor_date:
            break
        if pe <= current:
            continue
        if ps > current:
            end = ps
            if censor_date is not None and censor_date < end:
                segs.append({
                    "PERSON_ID": person_id,
                    "risk_start": current,
                    "risk_end": censor_date,
                    "end_reason": censor_reason(censor_date)
                })
                return segs
            segs.append({
                "PERSON_ID": person_id,
                "risk_start": current,
                "risk_end": end,
                "end_reason": "pregnancy"
            })
        current = max_date(current, pe)
        if censor_date is not None and censor_date <= current:
            return segs

    if censor_date is None or current < censor_date:
        end = censor_date
        end_reason = censor_reason(end) if end is not None else None
        segs.append({
            "PERSON_ID": person_id,
            "risk_start": current,
            "risk_end": end,
            "end_reason": end_reason
        })

    return segs

