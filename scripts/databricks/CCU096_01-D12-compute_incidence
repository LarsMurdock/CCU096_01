# Identify people who attend GP at least once every year
t = (trends_30kgm2
     .select("PERSON_ID",
             f.to_date("entry_date").alias("entry_date"),
             f.to_date("exit_date").alias("exit_date")))

a = (attendances
     .select("PERSON_ID", f.to_date("DATE").alias("visit_date")))

# Keep only visits within follow-up window
vis = (t.join(a, "PERSON_ID", "left")
        .where((f.col("visit_date") >= f.col("entry_date")) &
               (f.col("visit_date") <= f.col("exit_date"))))

# Sort visits within patient and compute gaps
w = w.partitionBy("PERSON_ID").orderBy("visit_date")

vis_gaps = (vis
    .withColumn("prev_visit", f.lag("visit_date").over(w))
    .withColumn(
        "gap_days",
        f.when(f.col("prev_visit").isNull(),
               f.datediff(f.col("visit_date"), f.col("entry_date")))  # entry -> first visit
         .otherwise(F.datediff(F.col("visit_date"), f.col("prev_visit")))  # between visits
    )
)

# Per patient: max gap among (entry->first, between visits) AND also check last->exit
per_patient = (vis_gaps
    .groupBy("PERSON_ID", "entry_date", "exit_date")
    .agg(
        f.count("*").alias("n_visits"),
        f.max("gap_days").alias("max_gap_internal"),
        f.max("visit_date").alias("last_visit")
    )
    .withColumn("gap_last_to_exit", f.datediff(F.col("exit_date"), f.col("last_visit")))
    .withColumn("max_gap_overall", f.greatest("max_gap_internal", "gap_last_to_exit"))
    .withColumn("meets_182_rule", (f.col("n_visits") > 0) & (f.col("max_gap_overall") <= 182.5))
    .withColumn("meets_365_rule", (f.col("n_visits") > 0) & (f.col("max_gap_overall") <= 365))
    .withColumn("meets_730_rule", (f.col("n_visits") > 0) & (f.col("max_gap_overall") <= 730))
    .withColumn("meets_1095_rule", (f.col("n_visits") > 0) & (f.col("max_gap_overall") <= 1095))
    .withColumn("meets_1460_rule", (f.col("n_visits") > 0) & (f.col("max_gap_overall") <= 1460))
    .withColumn("meets_1825_rule", (f.col("n_visits") > 0) & (f.col("max_gap_overall") <= 1825))
)

result_a = (
    t.join(per_patient.select("PERSON_ID", "meets_182_rule", "meets_365_rule", "meets_730_rule", "meets_1095_rule", "meets_1460_rule", "meets_1825_rule"), "PERSON_ID", "left")
    .fillna({"meets_182_rule": False})
    .fillna({"meets_365_rule": False})
    .fillna({"meets_730_rule": False})
