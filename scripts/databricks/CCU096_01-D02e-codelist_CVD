# MAGIC
# MAGIC | Non-fatal cardiovascular disease | ICD10 | 
# MAGIC | ----------- | ----------- | 
# MAGIC | Peripheral artery disease | I70-I71 | 
# MAGIC | TIA | G45 |
# MAGIC | Non-fatal angina | I20 |
# MAGIC | Ischaemic heart disease | I24-I25 |
# MAGIC
# MAGIC We also include the SNOMED codes for TIA from the phenotype library.

# COMMAND ----------

# DBTITLE 1,Collect CVD history ICD-10 codelist
# ICD-10 codes for CVD exclusion criteria are a superset of the CVD endpoint codelist
cvd_hx_conditions = cvd_nonfatal_conditions | {
    # For peripheral artery disease, get any codes with prefix I70, I71
    'peripheral_artery_disease': f.col('CODE').rlike("^(I70|I71)"),
    # For transient ischaemic attacks, get any codes with prefix G45
    'transient_ischaemic_attack': f.col('CODE').rlike("^(G45)"),
    # For angina, get any codes with prefix I20
    'nonfatal_angina': f.col('CODE').rlike("^(I20)"),
    # For ischaemic heart disease, get any codes with prefix I24, I25
    'ischaemic_heart_disease': f.col('CODE').rlike("^(I24|I25)")
}

codelist_cvd_hx = cleanup_icd10(icd10_codelist_from_conditions(cvd_hx_conditions))

codelists_all['codelist_cvd_hx'] = codelist_cvd_hx

# COMMAND ----------

# MAGIC %md ## 3.2. Outcome: Fatal CVD
# MAGIC
# MAGIC **Protocol - Fatal Codelist**
# MAGIC
# MAGIC | Fatal cardiovascular disease | ICD10 | 
# MAGIC | ----------- | ----------- | 
# MAGIC | Hypertensive disease | I10-16 | 
# MAGIC | Ischaemic heart disease | I20-25 |
# MAGIC | Arrhythmias, heart failure | I46-52 |
# MAGIC | Cerebrovascular disease | I60-69 |
# MAGIC | Atherosclerosis/AAA | I70-73 |
# MAGIC | Sudden death and death within 24h of symptom onset | R96.0-96.1 |
# MAGIC
# MAGIC These are the ICD-10 codes found in the protocol, matching those used in SCORE2 derivation. The exclusions are the same as the non-fatal CVD endpoint. We look up which patients have these in HES. CPJ advised the reason we only consider ICD-10 codes in HES and don't check for any CVD SNOMED codes in GDPPR is 
# MAGIC   
# MAGIC   - a) To match SCORE2, which was derived on hospital data
# MAGIC   - b) CVD episodes are not usually coded in primary care 
# MAGIC   - c) To catch more "severe" cases.

# COMMAND ----------

# DBTITLE 1,Import fatal CVD CSV
cvd_fatal_conditions = {
    'fatal_hypertensive_disease': f.col('ICD10_GROUP_HEADING') == 'I10-I15',
    'fatal_ischaemic_heart_disease': f.col('ICD10_GROUP_HEADING') == 'I20-I25',
    'fatal_arrythmias_heart_failure': f.col('CODE').rlike('^(I46|I47|I48|I49|I50|I51|I52)'),
    'fatal_cerebrovascular_disease': f.col('ICD10_GROUP_HEADING') == 'I60-I69',
    'fatal_atherosclerosis': f.col('CODE').rlike('^(I70|I71|I72|I73)'),
    'fatal_sudden_death': f.col('CODE').startswith('R96')
}

codelist_cvd_fatal = cleanup_icd10(icd10_codelist_from_conditions(cvd_fatal_conditions)).where(~f.col('code').rlike(cvd_icd10_exclusion_regex))

codelists_all['cvd_fatal'] = codelist_cvd_fatal

