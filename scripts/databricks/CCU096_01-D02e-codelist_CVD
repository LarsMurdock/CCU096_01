# MAGIC %md ## 3.1. Outcome: Non-fatal CVD
# MAGIC
# MAGIC The SCORE2 specification uses a narrower code-list for non-fatal CVD events, and a broader one for fatal CVD events. First we derive the former, based on the following table:
# MAGIC
# MAGIC **SCORE2 Non-fatal Codelist**
# MAGIC
# MAGIC | Non-fatal cardiovascular disease | ICD10 | 
# MAGIC | ----------- | ----------- | 
# MAGIC | Non-fatal myocardial infarction | I21-I23 | 
# MAGIC | Non-fatal stroke | I60-69 |
# MAGIC
# MAGIC | Excluded from the non-fatal CVD endpoint: | ICD10 | 
# MAGIC | ----------- | ----------- | 
# MAGIC | Myocarditis, unspecified | I51.4 | 
# MAGIC | Subarachnoid hemorrhage | I60 | 
# MAGIC | Subdural hemorrhage  | I62 |
# MAGIC | Cerebral aneurysm  | I67.1 |
# MAGIC | Cerebral arteritis  | I68.2 |
# MAGIC | Moyamoya  | I67.5 |
# MAGIC
# MAGIC **Additional exclusions from CCU004_03**
# MAGIC | Excluded from the non-fatal CVD endpoint: | ICD10 | 
# MAGIC | ----------- | ----------- | 
# MAGIC | Chronic ischaemic heart disease | I25 | 
# MAGIC | Old myocardial infarction | I25.2 | 
# MAGIC | Complications and ill defined dsecriptions of heart disease  | I51 |
# MAGIC | Other cerebrovascular diseases  | I67 |
# MAGIC | Cerebrovascular disorders in diseases classified elsewhere  | I68 |

# COMMAND ----------

# DBTITLE 1,Functions for deriving ICD-10 codelists
from typing import Dict 
from functools import reduce
def icd10_codelist_from_conditions(conditions: Dict[str, Column]) -> DataFrame: 
    """ Given a dictionary with covariate names as keys and boolean condition expressions as values,
    Derives a codelist from the ICD-10 reference table based on these conditions, with the keys assigned as the covariate names. 
    """
    icd10_subsets = [
        icd10.where(condition).withColumn('name', f.lit(name))
        for name, condition in conditions.items()
    ]
    df =  reduce(DataFrame.unionByName, icd10_subsets)

    # Re-format to fit our usual codelist format
    return (
        df
        .drop('CODE')
        .withColumnRenamed('ALT_CODE','code')
        .withColumnRenamed('ICD10_DESCRIPTION', 'term')
        .withColumn('terminology', f.lit('ICD10'))
        .select('name', 'terminology', 'code', 'term')
    )

def cleanup_icd10(df):
    # Remove trailing X's, decimal points, dashes, and spaces
    df = (
        df.withColumn('_code_old', f.col('code'))
        .withColumn('code', f.when(f.col('terminology') == 'ICD10', f.regexp_replace('code', r'X$', '')).otherwise(f.col('code')))\
        .withColumn('code', f.when(f.col('terminology') == 'ICD10', f.regexp_replace('code', r'[\.\-\s]', '')).otherwise(f.col('code')))
        .withColumn('_code_diff', f.when(f.col('code') != f.col('_code_old'), 1).otherwise(0))
    )
    # Reformatted codes _code_diff == 1
    print(f'Reformatted {df.select(f.sum("_code_diff")).collect()[0][0]} codes')
    return df.drop('_code_old', '_code_diff')

# COMMAND ----------

# DBTITLE 1,Collect CVD ICD-10 codelist
# First, ICD-10 codes for CVD
cvd_nonfatal_conditions = {
    # For MIs, get any codes with prefix I21, I22, I23
    'nonfatal_myocardial_infarction': f.col('CODE').rlike('^(I21|I22|I23)'),
    # For strokes, get any codes with prefix I60-I69
    'nonfatal_stroke': f.col('ICD10_GROUP_HEADING') == "I60-I69"
}

# Manual exclusions. Some are from the SCORE2 specification, others are cleanup applied in CCU004_03
cvd_icd10_exclusions_score2 = ['I514', 'I60', 'I62', 'I671', 'I682', 'I675']
cvd_icd10_exclusions_ccu00403 = ['I25', 'I252', 'I51', 'I67', 'I68']
cvd_icd10_exclusion_regex = f"^({'|'.join(cvd_icd10_exclusions_score2 + cvd_icd10_exclusions_ccu00403)})"

derive_cvd_nonfatal_icd10 = cleanup_icd10(icd10_codelist_from_conditions(cvd_nonfatal_conditions))

# We apply the exclusion criteria defined above. We intentionally don't apply them to the exclusion codelist
codelist_cvd_nonfatal = derive_cvd_nonfatal_icd10.where(~f.col('code').rlike(cvd_icd10_exclusion_regex))

codelists_all['cvd_nonfatal'] = codelist_cvd_nonfatal

