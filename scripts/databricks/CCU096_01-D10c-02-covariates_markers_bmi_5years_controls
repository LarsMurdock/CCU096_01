# MAGIC We inspect the proportion of cohort patients that have a non-null & non-NaN value for each collected marker. 

# COMMAND ----------

def dataframe_coverage(df, columns = None): 
    # Select all the columns of the frame if a list isn't provided
    columns = columns or df.columns
    # Magic query to obtain the coverage proportion of each given column
    result = df.select([(f.count(f.when((~f.isnan(c)) & f.col(c).isNotNull(), c))/f.count(f.lit(1))).alias(c) for c in columns])
    # Formatting 
    return result.toPandas().T.reset_index().rename(columns={'index': 'Column', 0: 'Coverage'})

