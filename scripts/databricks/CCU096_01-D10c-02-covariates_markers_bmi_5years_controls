    # Left join with the cohort table to attach date of birth and sex columns to all measurements
    .join(cohort.select('PERSON_ID', 'date_of_birth', 'sex'), on='PERSON_ID', how='left')
    # Take the difference (in years) between the measurement date and DOB to obtain the age at measurement time
    .withColumn('age', f.datediff('DATE', 'date_of_birth')/365.25)
    # Convert the measurement units from umol/L to mg/dL
    .withColumn('VALUE1_CONDITION', convert_creatinine_units(f.col('VALUE1_CONDITION')))
    # Apply the conversion rule to obtain eGFR from creatinine using creatinine, sex, and age at measurement time
    .withColumn('VALUE1_CONDITION', derive_egfr_from_creatinine(
        f.col('VALUE1_CONDITION'), f.col('sex'), f.col('age')
    ))
    # Name the new covariate appropriately (still distinguishing from original eGFR measurements)
    .withColumn('name', f.lit('egfr_creat'))
