import matplotlib.ticker as ticker
def bar_availability_over_ages(df_matched_ages):
    # Helper function to aggregate a grouped column into its completeness:
    # Take the count of values that are not Null or NaN and divide by the total length of the column
    column_completeness = lambda col: (f.count(f.when((~f.isnan(col)) & f.col(col).isNotNull(), col))/f.count(f.lit(1)))

    # Formulate the table of covariate availability
    df = (
        df_matched_ages
        # Round the age to the nearest year
        .withColumn('Age (years)', f.round(f.col('Age')).cast('integer'))
        # Group the patient records by discrete age
        .groupby('Age (years)')
        # Aggregate each covariate column of interest by its completeness
        .agg(*[
            column_completeness(f'cov_mark_{key}_value').alias(value) 
            for key, value in markers_pretty_print.items()
        ])
        # Melt from wide format (Age (years), BMI, Systolic BP, ...) to long (Age (years), name = [BMI, Systolic BP,...], value = ...)
        .melt(ids='Age (years)', values=list(markers_pretty_print.values()), variableColumnName='name', valueColumnName='value')
    ).toPandas()

    fig = sns.catplot(
        # Plotting parameters: Bar plot over discrete ages, faceted by covariate
        data=df, x='Age (years)', y='value', col='name', kind='bar',
        # Appearance: 4 facets per row, 4x4 squares, no shared axes
        col_wrap=4, height=4, sharex=False, sharey=False
    )

    # Magic to clean up the x-axes: We tick every 10 years
    for ax in fig.axes:
        ticks = np.array([18, 20, 30, 40, 50, 60, 70, 80, 89])
        ax.xaxis.set_major_locator(ticker.FixedLocator(locs=ticks-18))
        ax.xaxis.set_major_formatter(ticker.FixedFormatter(ticks))

    # By default, FacetGrid would title each sub-plot as "name=nonfatal_stroke". This command just removes the "name=" part. 
    fig.set_titles('{col_name}')
    return fig 

fig = bar_availability_over_ages(df_matched_ages)