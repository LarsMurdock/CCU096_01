# DBTITLE 1,Load data
codelist_glp1ra = spark.createDataFrame(
    pd.read_csv('./codelists/glp1ra_codelist.csv')
    [['type', 'category', 'bnf_code', 'raw_name', 'standardised_name', 'product_name']]
)

inc_exc = spark.table(Paths.tmp_inc_exc_cohort_2)
skinny  = spark.table(Paths.cur_skinny)
