display(pmeds)

# COMMAND ----------

display(codelist_glp1ra.groupBy("standardised_name").agg(f.count("*")))

# COMMAND ----------

# DBTITLE 1,Prepare PMEDS
pmeds_prepared = (
    pmeds
    # Reduce and rename columns
    .select(['Person_ID_DEID', 'EPSPrescriptionID', 'ProcessingPeriodDate', 'PrescribedBNFCode', 'PrescribedBNFName', 'PrescribedFormulation', 'PrescribedMedicineStrength', 'PrescribedQuantity', 'PrescriberType', 'PrivatePrescriptionIndicator', 'PaidDrugStrength', 'PaidQuantity', 'PaidFormulation', 'NotDispensedIndicator', 'PrescribedSupplierName', 'ItemActualCost', 'CostCentreODSCode', 'CostCentreSubType', 'DispensedPharmacyLSOA', 'DispensedPharmacyODSCode'])
    .filter(f.col("Person_ID_DEID").isNotNull())
    .withColumnRenamed('Person_ID_DEID', 'PERSON_ID')
    .withColumnRenamed('ProcessingPeriodDate', 'DATE')
    .withColumnRenamed('PrescribedBNFCode', 'bnf_code')

    # Inner join with GLP1-RA codelist
    .join(codelist_glp1ra, on='bnf_code', how='inner')
    # Left join with skinny table
    .join(skinny, on='PERSON_ID', how='left')
)

# COMMAND ----------

display(pmeds_prepared)

# COMMAND ----------

save_table(df=pmeds_prepared, out_name=f'{Project.name}_out_covariates_glp1ra', save_previous=True)

# COMMAND ----------

# DBTITLE 1,Check
qc = (
    pmeds
    .select('PrescribedBNFCode', 'PrescribedBNFName')
    .join(pmeds_prepared.select('PrescribedBNFName'), on='PrescribedBNFName', how='left_anti')
    .where(f.col('PrescribedBNFName').rlike('Semagluti|Ozemp'))
    .distinct()
)

display(qc)