from pyspark.sql import DataFrame
from pyspark.sql import functions as F
from pyspark.sql.types import DoubleType, IntegerType, FloatType

def compute_incidence_denominator_crude(data: DataFrame, by: str = None) -> DataFrame:
    """
    Compute the incidence denominator by summing 'days_' columns, optionally grouped by a specified column,
    and reshaping the data.

    Args:
        data (DataFrame): Input PySpark DataFrame.
        by (str, optional): Column name to group by. Defaults to None.

    Returns:
        DataFrame: Processed DataFrame with summed and reshaped data.
    """

    # Step 1: Identify columns starting with "days_"
    day_cols = [c for c in data.columns if c.startswith("days_")]

    if not day_cols:
        raise ValueError("No columns starting with 'days_' found in the data.")

    # Step 2: Sum the 'days_' columns
    if by:
        # Ensure the 'by' column exists
        if by not in data.columns:
            raise ValueError(f"The specified 'by' column '{by}' does not exist in the data.")
        
        sum_df = data.groupBy(by).agg(*[F.sum(F.col(c)).alias(c) for c in day_cols])
    else:
        sum_df = data.agg(*[F.sum(F.col(c)).alias(c) for c in day_cols])

    # Step 3: Reshape the summed data from wide to long format
    if by:
        # Number of day columns
        n = len(day_cols)
        
        # Create the stack expression
        stack_expr = "stack({0}, {1}) as (date, py)".format(
            n,
            ", ".join([f"'{c}', {c}" for c in day_cols])
        )
        
        # Melt the DataFrame
        melted = sum_df.select(by, F.expr(stack_expr))
        
        # Pivot wider: date as rows, 'by' levels as columns
        reshaped = melted.groupBy("date").pivot(by).agg(F.first("py"))
    else:
        # Number of day columns
        n = len(day_cols)
        
        # Create the stack expression
        stack_expr = "stack({0}, {1}) as (date, all)".format(
            n,
            ", ".join([f"'{c}', {c}" for c in day_cols])
        )
        
        # Melt the DataFrame
        reshaped = sum_df.select(F.expr(stack_expr))

   # Step 4: Transformations
    # a. Divide numeric columns by 365.25 to convert days to years
    numeric_cols = [
        c for c in reshaped.columns 
        if c not in ["date"] and reshaped.schema[c].dataType.typeName() in [
            "double", "integer", "float", "long", "decimal"
        ]
    ]
    
    # Debugging: Print identified numeric columns
    print(f"Numeric columns to convert: {numeric_cols}")
    
    for c in numeric_cols:
        reshaped = reshaped.withColumn(c, F.col(c).cast(DoubleType()) / 365.25)

    # b. Create 'months' and 'years' columns
    reshaped = reshaped.withColumn(
        "months",
        F.when(~F.col("date").contains("all"),
               F.regexp_extract("date", "[A-Z].{2}", 0))
         .otherwise("All")
    ).withColumn(
        "years",
        F.when(~F.col("date").contains("all"),
               F.concat(F.lit("20"), F.regexp_extract("date", "[0-9]{2}$", 0)))
         .otherwise("All")
    )

    # c. Reorder columns: 'months', 'years', then others
    other_cols = [c for c in reshaped.columns if c not in ["months", "years"]]
    reshaped = reshaped.select("months", "years", *other_cols)

    # d. Drop 'date' column
    reshaped = reshaped.drop("date")

    # e. Rename columns: if not 'months' or 'years', lowercase and append '_py'
    for c in reshaped.columns:
        if c.lower() not in ["months", "years"]:
            reshaped = reshaped.withColumnRenamed(c, f"{c.lower()}_py")
        else:
            reshaped = reshaped.withColumnRenamed(c, c.lower())

    return reshaped

