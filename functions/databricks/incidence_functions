from pyspark.sql import DataFrame
from pyspark.sql import functions as F
from pyspark.sql.types import DoubleType

def compute_incidence_denominator_by_year(data: DataFrame, by: str = None) -> DataFrame:
    """
    Compute the incidence denominator by summing 'days_' columns, optionally grouped by a specified column,
    but aggregate by calendar year (extracted from column names) rather than by calendar month.

    Args:
        data (DataFrame): Input PySpark DataFrame.
                         Must contain columns starting with 'days_' (e.g., 'days_2020').
        by (str, optional): Column name to group by. Defaults to None.

    Returns:
        DataFrame: Processed DataFrame with summed and reshaped data, 
                   including a 'year' column and any grouping columns, 
                   plus incidence denominators (in years) suffixed with '_py'.
    """
    # 1) Identify columns starting with "days_"
    day_cols = [c for c in data.columns if c.startswith("days_")]
    if not day_cols:
        raise ValueError("No columns starting with 'days_' found in the data.")
    
    # 2) Sum the 'days_' columns across the dataset
    if by:
        # Check the grouping column actually exists
        if by not in data.columns:
            raise ValueError(f"The specified 'by' column '{by}' does not exist in the data.")
        sum_df = data.groupBy(by).agg(*[F.sum(F.col(c)).alias(c) for c in day_cols])
    else:
        sum_df = data.agg(*[F.sum(F.col(c)).alias(c) for c in day_cols])
    
    # 3) Reshape the summed data from wide to long
    #    We'll "stack" the day_cols into (date, value) pairs, 
    #    but here 'date' is actually a placeholder that we'll parse as a year
    if by:
        # For grouping case
        n = len(day_cols)
        stack_expr = "stack({0}, {1}) as (date, py)".format(
            n,
            ", ".join([f"'{c}', {c}" for c in day_cols])
        )
        
        melted = sum_df.select(by, F.expr(stack_expr))
        
        # Pivot wide: row per 'date', columns per group
        reshaped = melted.groupBy("date").pivot(by).agg(F.first("py"))
    else:
        # No grouping
        n = len(day_cols)
        stack_expr = "stack({0}, {1}) as (date, all)".format(
            n,
            ", ".join([f"'{c}', {c}" for c in day_cols])
        )
        reshaped = sum_df.select(F.expr(stack_expr))
    
    # 4) Convert numeric columns from days => years by dividing by 365.25
    numeric_cols = [
        c for c in reshaped.columns 
        if c not in ["date"] 
           and reshaped.schema[c].dataType.typeName() in ["double", "integer", "float", "long", "decimal"]
    ]
    
    for c in numeric_cols:
        reshaped = reshaped.withColumn(c, F.col(c).cast(DoubleType()) / 365.25)
    
    # 5) Extract the 4-digit year from the 'date' column name (e.g., "days_2020" -> "2020")
    #    If your columns are named like "days_19" or "days_2019", adjust the regex as needed.
    reshaped = reshaped.withColumn(
        "year",
        F.when(
            ~F.col("date").contains("all"),
            F.regexp_extract("date", "([0-9]{4})$", 1)  # capture 4 digits at the end
        ).otherwise("All")
    )
    
    # 6) Reorder so that 'year' is first (plus grouping columns, if any)
    #    Identify columns besides 'year' (and 'date' which we'll drop)
    keep_cols = [c for c in reshaped.columns if c not in ["date", "year"]]
    reshaped = reshaped.select("year", *keep_cols)
    
    # 7) Drop the 'date' column
    reshaped = reshaped.drop("date")
    
    # 8) Rename remaining numeric columns to something like "xxx_py"
    #    except for "year" or pivoted group columns
    for c in reshaped.columns:
        # Skip 'year'
        if c.lower() not in ["year"]:
            # For pivoted grouping, c might be your group values
            # If you'd like to suffix them with _py as well, remove the check
            # that c isn't in a pivot group
            reshaped = reshaped.withColumnRenamed(c, f"{c.lower()}_py")
    
    return reshaped

