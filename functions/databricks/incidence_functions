import pyspark.sql.functions as f
from datetime import datetime
from dateutil.relativedelta import relativedelta
from functools import reduce

def compute_days_at_risk(
    df,
    start_date_str: str,  # e.g. "2020-01-01"
    end_date_str: str,    # e.g. "2024-06-30"
    cov_hx_col: str = "cov_hx_first_obesity_date",
    death_col: str = "date_of_death",
    date90_col: str = "date_90",
    date18_col: str = "date_18",
    gdppr_col: str = "gdppr_earliest"
):
    """
    Mimics the R function 'compute_days_at_risk' in PySpark.
    1) Calculates how many months between start_date_str and end_date_str.
    2) Generates a list of (month_abb, year) pairs.
    3) For each pair, creates a new column computing days at risk.
    4) Sums all such columns into 'days_all_years'.
    5) Returns a DataFrame with these new columns added.
    """
    # Parse the input strings into Python datetime objects
    start_date_obj = datetime.strptime(start_date_str, "%Y-%m-%d")
    end_date_obj   = datetime.strptime(end_date_str,   "%Y-%m-%d")

    # 1) Calculate number of months between .start_date and .end_date, inclusive
    #    R code: interval(.start_date, .end_date) %/% months(1) + 1
    #    We'll do it with a while loop or a helper:
    def months_between_inclusive(d1, d2):
        # If d1 > d2, return 0
        # Else count how many times we add 1 month from d1 until we pass d2
        if d1 > d2:
            return 0
        count = 0
        temp = d1
        while temp <= d2:
            count += 1
            # Move to the next month
            temp = temp + relativedelta(months=1)
        return count

    months_diff = months_between_inclusive(start_date_obj, end_date_obj)

    # 2) Generate the vector of months (short abbreviations) and years
    #    R does: rep(month.abb, length.out = months_diff)
    #    We'll cycle through month abbreviations in Python:
    month_abbs = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    
    repeated_months = [month_abbs[(i % 12)] for i in range(months_diff)]
    # R does: repeated_years = as.numeric(start_year) + floor((seq_along(...) - 1) / 12)
    start_year = start_date_obj.year
    repeated_years = [start_year + (i // 12) for i in range(months_diff)]
    
    # 3) Build column names, e.g. "days_May20"
    #    R code: sub("^[0-9]{2}", "", year_i) is effectively the last 2 digits
    #    We'll do str(year_i)[-2:] for the last two digits
    def build_col_name(m, y):
        # y_last2 => e.g. 2023 -> "23"
        y_last2 = str(y)[-2:]
        return f"days_{m}{y_last2}"

    col_names = [build_col_name(m, y) for m, y in zip(repeated_months, repeated_years)]

    # 4) For each month-year pair, create a new column in the DataFrame
    #    using the expression function from above
    from pyspark.sql import DataFrame

    # We'll store the new DF in a variable so we can keep adding columns
    df_out = df
    for (month_i, year_i, col_name_i) in zip(repeated_months, repeated_years, col_names):
        days_expr = compute_days_at_risk_individual(
            month_str=month_i,
            year_str=str(year_i),
            start_str=start_date_str,
            end_str=end_date_str,
            cov_hx_col=cov_hx_col,
            death_col=death_col,
            date90_col=date90_col,
            date18_col=date18_col,
            gdppr_col=gdppr_col
        )
        df_out = df_out.withColumn(col_name_i, days_expr)

    # 5) days_all_years = rowSums(...) in R => we sum all those new columns
    #    We'll use a reduce over the columns. If col_names is empty, days_all_years = 0
    if col_names:
        sum_expr = reduce(
            lambda a, b: a + b,
            [f.col(c) for c in col_names],
            f.lit(0)
        )
    else:
        sum_expr = f.lit(0)

    df_out = df_out.withColumn("days_all_years", sum_expr)

    return df_out

