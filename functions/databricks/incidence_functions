      .withColumn("date_col_first_of_month", f.trunc(date_col, "month"))
      .withColumn(
          "age", f.floor(f.months_between(f.col("date_col_first_of_month"), f.col("date_of_birth")) / 12)
      )
      .withColumn(
          "age_grp_5yr",
          f.when(
              f.col("age") <= 89,
              f.concat_ws(
                 "-",
                (f.floor(F.col("age") / 5) * 5).cast("string"),
                ((f.floor(F.col("age") / 5) * 5) + 4).cast("string")
              )
          ).otherwise("90+")
          # .otherwise(None)  # or .otherwise("90+") if you want a "90+" bucket
      )
    ) 

    # ----------------------------------------------------------------------------
    # 5) Group or Pivot
    # ----------------------------------------------------------------------------
    # If by_col is None => group by (months, years) => countDistinct(id_col)
    # If by_col is not None => pivot by that column
    #
    # R code:
    # if(missing(.by)) {
    #   numerator <- numerator |> summarise(n = n_distinct(person_id), .by = c(months, years))
    # } else {
    #   numerator <- numerator
    #       |> summarise(n = n_distinct(person_id), by = c(months, years, {{ .by }}))
    #       |> pivot_wider(id_cols = c(months, years), names_from = .by, values_from = n)
    # }
    
    if by_col is None:
        # Just group by (months, years)
        numerator_grouped = (
            numerator_df
            .groupBy("months", "years", "sex", "age_grp_5yr")
            .agg(f.countDistinct(id_col).alias("n"))
        )

        # ----------------------------------------------------------------------------
        # 6) Left Join months_years_df with numerator_grouped
        # ----------------------------------------------------------------------------
        # R code: years_and_months |> left_join(numerator, by = join_by(months, years))
        # We do the same in PySpark => on=["months","years"], how="left"
        df_out = (
           months_years_df
           .join(numerator_grouped, on=["months", "years"], how="left")
        )
    
    elif by_col == "msoa":
        numerator_grouped = (
            numerator_df
            .drop("months")
            .groupBy("years", "sex", "age_grp_5yr", by_col)
            .agg(f.countDistinct(id_col).alias("n"))
        )

        df_out = (
            months_years_df
            .select('years')
            .distinct()
            .join(numerator_grouped, on="years", how="left")
        )

    else:
        # We pivot by by_col
        # Summarize distinct person_id by (months, years, by_col)
        # Then pivot so that each unique value of by_col becomes a column
        numerator_grouped = (
            numerator_df
            .groupBy("months", "years", "sex", "age_grp_5yr")   # grouping keys
            .pivot(by_col)                       # pivot on .by column
            .agg(f.countDistinct(id_col))        # aggregator
        )

        df_out = (
            months_years_df
            .join(numerator_grouped, on=["months", "years"], how="left")
        )    
        # the resulting DataFrame will have columns: months, years, plus one column per .by value

    return df_out

