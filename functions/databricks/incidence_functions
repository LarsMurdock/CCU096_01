from pyspark.sql import DataFrame
from pyspark.sql import functions as F
from pyspark.sql.types import DoubleType, IntegerType, FloatType

def compute_incidence_denominator_standardised(data: DataFrame, by: str = None) -> DataFrame:
    """
    Compute the incidence denominator by summing 'days_' columns, optionally grouped by a specified column,
    and reshaping the data.

    Args:
        data (DataFrame): Input PySpark DataFrame.
        by (str, optional): Column name to group by. Defaults to None.

    Returns:
        DataFrame: Processed DataFrame with summed and reshaped data.
    """

    # Step 0: Code 5-year age groups
    # Identify all columns beginning with 'age_'
    cols_to_transform = [c for c in data.columns if c.startswith("age_")]

    # Loop through each such column and overwrite it
    for age_col in cols_to_transform:
      data = data.withColumn(
        age_col,
        F.when(
            F.col(age_col) <= 89,
            F.concat_ws(
                "-",
                (F.floor(F.col(age_col) / 5) * 5).cast("string"),
                ((F.floor(F.col(age_col) / 5) * 5) + 4).cast("string")
            )
        ).otherwise("90+") # to use a bucket for ages ≥ 90
    )
      
    # 1. Identify the days columns.
    #    We assume days columns are named with prefix "days_".
    days_cols = [col for col in data.columns if col.startswith("days_")]

    # 2. Derive the month suffixes from the days columns.
    #    For example, from "days_Jan19" we extract "Jan19".
    months = sorted([col[5:] for col in days_cols])

    # 3. Build the stack() expression.
    #    For each month, we provide three expressions:
    #    - A literal with the month-year suffix (e.g. 'Jan19')
    #    - The corresponding days column (e.g. days_Jan19)
    #    - The corresponding age column (e.g. age_Jan19)
    #
    #    Note: We use backticks to refer to column names that include underscores.
    n = len(months)
    stack_expr = "stack({0}, {1}) as (month_year, days, age)".format(
        n,
        ", ".join([f"'{m}', `days_{m}`, `age_{m}`" for m in months])
    )

    if by is None:
        
        # 4. Apply the stack() expression.
        data_long = data.select("person_id", "sex", F.expr(stack_expr))

    else:

        data_long = data.select("person_id", "sex", by, F.expr(stack_expr))

    # 5. Separate month_year into separate month and year columns.
    #    For example, if month_year is "Jan19", extract:
    #    - month: first 3 characters ("Jan")
    #    - year: next 2 characters ("19")
    data_long = (
        data_long
        .withColumn("months", F.expr("substring(month_year, 1, 3)"))
        .withColumn("years", F.expr("substring(month_year, 4, 2)"))
        .drop("month_year")
    )

    if by is None:

        data_long = (
            data_long
            .groupBy('sex', 'age', 'months', 'years')
            .agg((F.sum(F.col("days")) / F.lit(365.25)).alias("py"))
            .withColumn("years", F.col("years").cast("int") + F.lit(2000))
        )
    
    else:
        
        data_long = (
            data_long
            .groupBy('sex', 'age', by, 'months', 'years')
            .agg((F.sum(F.col("days")) / F.lit(365.25)).alias("py"))
            .withColumn("years", F.col("years").cast("int") + F.lit(2000))
        )

    return data_long

