from pyspark.sql import DataFrame
from datetime import datetime
from dateutil.relativedelta import relativedelta

def compute_incidence_numerator_crude(
    df: DataFrame,
    start_date_str: str = Project.study_start_date,  # e.g. "2020-01-01"
    end_date_str: str = Project.study_end_date,    # e.g. "2024-06-30"
    # Column names:
    date_col: str = "cov_hx_first_obesity_date",
    date90_col: str = "date_100",
    id_col: str = "person_id",
    by_col: str = None    # Optional stratification column name
) -> DataFrame:
    """
    PySpark equivalent of the R function 'compute_incidence_numerator'.

    1) Calculates how many months lie between start_date_str and end_date_str (inclusive).
    2) Builds a small Spark DataFrame of (months, years) for that range.
    3) Creates a "numerator" DataFrame by extracting months, years from date_col (cov_hx_first_obesity_date).
    4) Groups by (months, years), optionally pivoting by by_col, to count distinct id_col.
    5) Left-joins the (months, years) DataFrame to fill missing month-year combinations with null.
    6) Returns the resulting DataFrame.

    :param df:              Main Spark DataFrame containing columns [date_col, id_col, (optionally by_col)].
    :param start_date_str:  Start date in "YYYY-MM-DD" format.
    :param end_date_str:    End date in "YYYY-MM-DD" format.
    :param date_col:        Column name that holds the date of first obesity (cov_hx_first_obesity_date).
    :param id_col:          Unique identifier column name (person_id).
    :param by_col:          Optional stratification column name (like .by in R). If None, no pivot is done.
    :return:                A Spark DataFrame with columns for months, years (and possibly pivoted columns), 
                            plus counts of distinct id_col per month-year.
    """

    # ----------------------------------------------------------------------------
    # 1) Compute how many months are between start_date_str and end_date_str (inclusive)
    # ----------------------------------------------------------------------------
    def months_between_inclusive(d1: datetime, d2: datetime) -> int:
        """Return the count of months from d1 up to and including d2."""
        if d1 > d2:
            return 0
        count = 0
        tmp = d1
        while tmp <= d2:
            count += 1
            tmp += relativedelta(months=1)
        return count

    # Parse start/end into Python datetime objects
    start_date_obj = datetime.strptime(start_date_str, "%Y-%m-%d")
    end_date_obj   = datetime.strptime(end_date_str,   "%Y-%m-%d")

    months_diff = months_between_inclusive(start_date_obj, end_date_obj)

    # ----------------------------------------------------------------------------
    # 2) Build a local list of (months, years) for that range
    # ----------------------------------------------------------------------------
    # R does: rep(month.abb, length.out = months_diff)
    # We'll cycle through Python abbreviations for months.
    month_abbs = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]

    # Repeated months
    repeated_months = [month_abbs[i % 12] for i in range(months_diff)]
    # Start year
    start_year_int = start_date_obj.year
    repeated_years = [start_year_int + (i // 12) for i in range(months_diff)]

    # ----------------------------------------------------------------------------
    # 3) Create a small Spark DataFrame with columns "months", "years"
    # ----------------------------------------------------------------------------
    # We'll do this by constructing a local list of tuples and parallelizing:
    # e.g. [("Jan", 2020), ("Feb", 2020), ...]
    month_year_tuples = list(zip(repeated_months, repeated_years))  # List of (month, year)
    spark = df.sparkSession  # get the active SparkSession

    months_years_df = spark.createDataFrame(
        month_year_tuples,
        ["months", "years"]
    )

    # ----------------------------------------------------------------------------
    # 4) Create the "numerator" DataFrame by extracting months, years from 'date_col'
    # ----------------------------------------------------------------------------
    # R uses: mutate(
    #            months = format(cov_hx_first_obesity_date, "%b"),
    #            years  = format(cov_hx_first_obesity_date, "%Y")
    #         )
    #
    # => in PySpark: date_format(date_col, 'MMM') => e.g. "Jan", "Feb", ...
    #                date_format(date_col, 'yyyy') => e.g. "2020"

    numerator_df = (
      df
      .withColumn("months", f.date_format(f.col(date_col), "MMM"))
      .withColumn("years",  f.date_format(f.col(date_col), "yyyy"))
      .where(f.col(date_col) < f.col(date90_col))
    ) 

    # ----------------------------------------------------------------------------
    # 5) Group or Pivot
    # ----------------------------------------------------------------------------
    # If by_col is None => group by (months, years) => countDistinct(id_col)
    # If by_col is not None => pivot by that column
    #
    # R code:
    # if(missing(.by)) {
    #   numerator <- numerator |> summarise(n = n_distinct(person_id), .by = c(months, years))
    # } else {
    #   numerator <- numerator
    #       |> summarise(n = n_distinct(person_id), by = c(months, years, {{ .by }}))
    #       |> pivot_wider(id_cols = c(months, years), names_from = .by, values_from = n)
    # }
    
    if by_col is None:
        # Just group by (months, years)
        numerator_grouped = (
            numerator_df
            .groupBy("months", "years")
            .agg(f.countDistinct(id_col).alias("n"))
        )

        # ----------------------------------------------------------------------------
        # 6) Left Join months_years_df with numerator_grouped
        # ----------------------------------------------------------------------------
        # R code: years_and_months |> left_join(numerator, by = join_by(months, years))
        # We do the same in PySpark => on=["months","years"], how="left"
        df_out = (
           months_years_df
           .join(numerator_grouped, on=["months", "years"], how="left")
        )
    
    elif by_col == "msoa":
        numerator_grouped = (
            numerator_df
            .drop("months")
            .groupBy("years", by_col)
            .agg(f.countDistinct(id_col).alias("n"))
        )

        df_out = (
            months_years_df
            .select('years')
            .distinct()
            .join(numerator_grouped, on="years", how="left")
        )

    else:
        # We pivot by by_col
        # Summarize distinct person_id by (months, years, by_col)
        # Then pivot so that each unique value of by_col becomes a column
        numerator_grouped = (
            numerator_df
            .groupBy("months", "years")          # grouping keys
            .pivot(by_col)                       # pivot on .by column
            .agg(f.countDistinct(id_col))        # aggregator
        )

        df_out = (
            months_years_df
            .join(numerator_grouped, on=["months", "years"], how="left")
        )    
        # the resulting DataFrame will have columns: months, years, plus one column per .by value

    return df_out

