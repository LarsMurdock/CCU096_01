import pyspark.sql.functions as f
from functools import reduce
import datetime

def compute_days_at_risk_individual(
    month_str: str,
    year_str: str,
    start_str: str,
    end_str: str,
    cov_hx_col: str = "cov_hx_first_obesity_date",
    death_col: str = "date_of_death",
    date90_col: str = "date_90",
    date18_col: str = "date_18",
    gdppr_col: str = "gdppr_earliest"
) -> f.Column:
    """
    Returns a PySpark Column expression that computes the days at risk
    for each row, given a particular month/year, and start/end boundaries.
    """
    # 1. Construct the start of the chosen month, e.g. "2020-Jan-01"
    month_start = f.to_date(f.lit(f"{year_str}-{month_str}-01"), "yyyy-MMM-dd")

    # 2. End of that month: add 1 month, subtract 1 day
    month_end = f.date_sub(f.add_months(month_start, 1), 1)

    # 3. pmin(...) ignoring nulls by coalescing to a "far-future" date
    at_risk_end = f.array_min(f.array(
        f.coalesce(f.col(cov_hx_col), f.lit("9999-12-31")),
        f.coalesce(f.col(death_col),  f.lit("9999-12-31")),
        f.lit(end_str),  # e.g. "2024-06-31"
        f.coalesce(f.col(date90_col), f.lit("9999-12-31")),
        month_end
    ))

    # 4. pmax(...) ignoring nulls by coalescing to a "far-past" date
    at_risk_start = f.array_max(f.array(
        f.lit(start_str),  # e.g. "2020-01-01"
        f.coalesce(f.col(date18_col), f.lit("0001-01-01")),
        f.coalesce(f.col(gdppr_col),  f.lit("0001-01-01")),
        month_start
    ))

    # 5. days = pmax(datediff(end, start)+1, 0)
    days_expr = f.greatest(
        f.datediff(at_risk_end, at_risk_start) + 1,
        f.lit(0)
    )

    return days_expr

