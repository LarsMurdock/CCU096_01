from pyspark.sql import DataFrame
from pyspark.sql import functions as F
from pyspark.sql.types import DoubleType

def compute_incidence_denominator_by_year_pivoted(
    data: DataFrame,
    by: str
) -> DataFrame:
    """
    Compute the incidence denominator by summing 'days_' columns grouped by `by`,
    then pivot so each row is one level of `by`, and each column is one calendar year.

    EXAMPLE:
      If data columns: [by, days_2019, days_2020, days_2021, ...]
      Then final shape: each row => a distinct value of `by`
                        each column => one distinct year (e.g., 2019, 2020, 2021, ...)

    Args:
        data (DataFrame): 
          Must contain:
            - A grouping column `by` (string),
            - Columns named like 'days_YYYY' (e.g., 'days_2020') for each year.
        by (str): 
          The column name to group by. 
          Each row in the final result corresponds to one level of `by`.

    Returns:
        DataFrame: 
          Rows = distinct `by` values,
          Columns = distinct calendar years extracted from the 'days_' column names,
          Each cell is the total number of person-years (converted from days / 365.25).
    """

    # 1) Identify columns that start with "days_"
    day_cols = [c for c in data.columns if c.startswith("days_")]
    if not day_cols:
        raise ValueError("No columns starting with 'days_' found in the data.")

    # 2) Ensure the `by` column exists
    if by not in data.columns:
        raise ValueError(f"The specified 'by' column '{by}' does not exist in the data.")

    # 3) Sum the 'days_' columns by the grouping column
    sum_df = data.groupBy(by).agg(*[F.sum(F.col(c)).alias(c) for c in day_cols])

    # 4) Reshape from wide to long via stack. We'll get columns: [by, 'date', 'value']
    n = len(day_cols)
    stack_expr = "stack({0}, {1}) as (date, py)".format(
        n,
        ", ".join([f"'{c}', {c}" for c in day_cols])
    )
    melted = sum_df.select(by, F.expr(stack_expr))

    # 5) Convert from days to person-years by dividing by 365.25
    #    We'll do that right after the stack operation
    melted = melted.withColumn("py", F.col("py").cast(DoubleType()) / 365.25)

    # 6) Extract the 2-digit year from the 'date' column name
    #    e.g. "days_Nov20" => "20"
    melted = melted.withColumn(
        "year",
        F.regexp_extract("date", "([0-9]{2})$", 1)
    )

    # 7) Pivot so that columns become distinct years, and rows are each distinct `by`
    #    The value we place is 'py'.
    #    => results in columns [by, '2019', '2020', '2021', ...]
    #    Each cell is the total person-years
    pivoted = (
        melted.groupBy(by)
        .pivot("year")
        .agg(F.sum("py"))
        # note: if you want sum, we used first() because we already aggregated
        # if you had multiple rows per group-year, you might do sum().
    )

    # 8) (Optional) reorder columns so `by` is first, then ascending year columns
    #    We'll collect all year columns, sort them, then select in order
    non_by_cols = [c for c in pivoted.columns if c != by]
    # Sort numeric column names (strings) if possible
    # Some columns might be empty or "all" => handle if needed
    sorted_years = sorted([c for c in non_by_cols if c.isdigit()])  
    other_cols   = [c for c in non_by_cols if not c.isdigit()]

    final_cols = [by] + sorted_years + other_cols

    # return pivoted
    return pivoted.select(*final_cols)